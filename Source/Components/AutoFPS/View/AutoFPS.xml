<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Windows>
        <!-- Hidden 1x1 driver: hosts OnUpdate so AutoFPS can sample frame time while enabled. -->
        <Window name="CustomUIAutoFPSDriver" handleinput="false" layer="background" parent="Root" movable="false">
            <Size>
                <AbsPoint x="1" y="1" />
            </Size>
            <Anchors>
                <Anchor point="topleft" relativePoint="topleft" relativeTo="Root" />
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnUpdate" function="CustomUI.AutoFPS.OnUpdate" />
            </EventHandlers>
        </Window>
    </Windows>
</Interface>
