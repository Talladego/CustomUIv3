<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Windows>

		<!-- Compact: Killer[kills] killed Victim[kills] with Ability [in Zone] -->
		<Window name="CustomUIKillTrackerRow" movable="false" savesettings="false" handleinput="false">
			<Size>
				<AbsPoint x="512" y="28" />
			</Size>
			<Windows>
				<Label name="$parentKillerName" font="font_chat_text" maxchars="128"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="160" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentKillerCount" font="font_chat_text" maxchars="16"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="40" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentKillerName">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentText" font="font_chat_text" maxchars="32"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="64" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentKillerCount">
							<AbsPoint x="2" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentVictimName" font="font_chat_text" maxchars="128"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="160" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentText">
							<AbsPoint x="4" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentVictimCount" font="font_chat_text" maxchars="16"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="40" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentVictimName">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentWith" font="font_chat_text" maxchars="16"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="48" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentVictimCount">
							<AbsPoint x="4" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentAbilityName" font="font_chat_text" maxchars="256"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="320" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentWith">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<!-- " in " stays white; area name is green when local. -->
				<Label name="$parentZoneIn" font="font_chat_text" maxchars="16"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="32" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentAbilityName">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Label>

				<Label name="$parentZone" font="font_chat_text" maxchars="128"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="200" y="24" />
					</Size>
					<Anchors>
						<Anchor point="topright" relativePoint="topleft" relativeTo="$parentZoneIn">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Label>
			</Windows>
		</Window>

		<!-- Click-through kill lines. Lua glues this above the score window and grows it upward. -->
		<Window name="CustomUIKillTrackerWindow" movable="false" savesettings="false" layer="default" handleinput="false">
			<Size>
				<AbsPoint x="720" y="28" />
			</Size>
		</Window>

		<!-- LayoutEditor base + hover target. Feed sits on top of this row. -->
		<Window name="CustomUIKillTrackerScoreWindow" movable="true" savesettings="true" layer="default" handleinput="true">
			<Size>
				<AbsPoint x="720" y="28" />
			</Size>
			<Anchors>
				<Anchor point="center" relativePoint="center">
					<AbsPoint x="0" y="200" />
				</Anchor>
			</Anchors>
			<EventHandlers>
				<EventHandler event="OnUpdate" function="CustomUI.KillTracker.Window.OnUpdate" />
			</EventHandlers>
			<Windows>
				<FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="false" layer="background" alpha="0.5">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
					</Anchors>
					<TintColor r="0" g="0" b="0" />
				</FullResizeImage>
				<Label name="$parentZone" font="font_chat_text" maxchars="128"
					   textalign="leftcenter" handleinput="false" layer="popup">
					<Size>
						<AbsPoint x="200" y="24" />
					</Size>
					<Anchors>
						<Anchor point="left" relativePoint="left" relativeTo="$parent">
							<AbsPoint x="4" y="0" />
						</Anchor>
					</Anchors>
				</Label>
				<Label name="$parentFirstLabel" font="font_chat_text" maxchars="32"
					   textalign="leftcenter" handleinput="true" layer="popup">
					<Size>
						<AbsPoint x="120" y="24" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentZone">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
					<EventHandlers>
						<EventHandler event="OnMouseOver" function="CustomUI.KillTracker.Window.OnMouseOverFirstScore" />
					</EventHandlers>
				</Label>
				<Label name="$parentFirstCount" font="font_chat_text" maxchars="16"
					   textalign="rightcenter" handleinput="true" layer="popup">
					<Size>
						<AbsPoint x="40" y="24" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentFirstLabel">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
					<EventHandlers>
						<EventHandler event="OnMouseOver" function="CustomUI.KillTracker.Window.OnMouseOverFirstScore" />
					</EventHandlers>
				</Label>
				<Label name="$parentSecondLabel" font="font_chat_text" maxchars="32"
					   textalign="leftcenter" handleinput="true" layer="popup">
					<Size>
						<AbsPoint x="120" y="24" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentFirstCount">
							<AbsPoint x="16" y="0" />
						</Anchor>
					</Anchors>
					<EventHandlers>
						<EventHandler event="OnMouseOver" function="CustomUI.KillTracker.Window.OnMouseOverSecondScore" />
					</EventHandlers>
				</Label>
				<Label name="$parentSecondCount" font="font_chat_text" maxchars="16"
					   textalign="rightcenter" handleinput="true" layer="popup">
					<Size>
						<AbsPoint x="40" y="24" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentSecondLabel">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
					<EventHandlers>
						<EventHandler event="OnMouseOver" function="CustomUI.KillTracker.Window.OnMouseOverSecondScore" />
					</EventHandlers>
				</Label>
			</Windows>
		</Window>

	</Windows>
</Interface>
