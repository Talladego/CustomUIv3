<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../Interface.xsd">
    <Scripts>
        <Script file="Source/Components/PlayerStatusWindow/View/PlayerStatusWindow.lua" />
    </Scripts>
    <Windows>

        <!-- Player Window -->
        <Window name="CustomUIPlayerStatusWindow" movable="false" popable="false" savesettings="true">
            <Size>
                <AbsPoint x="270" y="111" />
            </Size>
            <Anchors>
                <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                    <AbsPoint x="8" y="27" />
                </Anchor>
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnInitialize" function="CustomUI.PlayerStatusWindow.Initialize" />
                <EventHandler event="OnUpdate" function="CustomUI.PlayerStatusWindow.Update" />
                <EventHandler event="OnShutdown" function="CustomUI.PlayerStatusWindow.Shutdown" />
                <EventHandler event="OnShown" function="CustomUI.PlayerStatusWindow.OnShown" />
                <EventHandler event="OnHidden" function="CustomUI.PlayerStatusWindow.OnHidden" />
            </EventHandlers>
            <Windows>
            
                <!-- Player Status Container -->
                <Window name="$parentStatusContainer" inherits="PlayerStatusContainerTemplate" layer="background">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="CustomUIPlayerStatusWindow">
                            <AbsPoint x="89" y="27" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonDown" function="CustomUI.PlayerStatusWindow.OnLButtonDown" />
                        <EventHandler event="OnRButtonUp" function="CustomUI.PlayerStatusWindow.OnRButtonUp" />
                    </EventHandlers>
                </Window>
                <!-- Player's Name — tucked toward portrait (career badge is on the frame, not beside the name). -->
                <Label name="$parentPlayerName" font="font_heading_unitframe_large_name" maxchars="15" textalign="bottomleft" layer="default">
                    <Size>
                        <AbsPoint x="155" y="23" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="CustomUIPlayerStatusWindow">
                            <AbsPoint x="98" y="8" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonDown" function="CustomUI.PlayerStatusWindow.OnLButtonDown" />
                        <EventHandler event="OnRButtonUp" function="CustomUI.PlayerStatusWindow.OnRButtonUp" />
                    </EventHandlers>
                </Label>

                <!-- Portrait Background-->
                <DynamicImage name="$parentPortraitBackground" inherits="PortraitBackground" handleinput="false" layer="default" popable="false">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                            <AbsPoint x="9" y="8" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                

                <!-- Portrait -->
                <CircleImage name="$parentPortrait" texture="render_scene_player_portrait" numsegments="16" layer="default" popable="false">
                    <Size>
                        <AbsPoint x="82" y="82" />
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverPortrait" />
                        <EventHandler event="OnMouseOverEnd" function="CustomUI.PlayerStatusWindow.MouseOverPortraitEnd" />
                        <EventHandler event="OnLButtonDown" function="CustomUI.PlayerStatusWindow.OnLButtonDown" />
                        <EventHandler event="OnRButtonUp" function="CustomUI.PlayerStatusWindow.OnRButtonUp" />
                    </EventHandlers>
                    <TexCoords x="50" y="50" />
                </CircleImage>
                
                
                <!-- Death Portrait -->
                <DynamicImage name="$parentDeathPortrait" inherits="DeathImage" scale="0.9" handleinput="false" layer="default" popable="false">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                            <AbsPoint x="9" y="8" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                

                <!-- Portrait Frame-->
                <DynamicImage name="$parentPortraitFrame" inherits="PortraitFrame" handleinput="false" layer="secondary" popable="false">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>

                <!-- Career badge: top-left portrait corner (Rank-Circle chrome). -->
                <DynamicImage name="$parentCareerIconBackground" inherits="LevelBackgroundTemplate" handleinput="false" popable="false" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="3" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                <DynamicImage name="$parentCareerIcon" textureScale="1.0" handleinput="true" layer="popup" popable="false">
                    <Size>
                        <AbsPoint x="20" y="20" />
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parentCareerIconBackground" />
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverCareerIcon" />
                    </EventHandlers>
                </DynamicImage>

                <!-- notes regarding size and texturescale:
                                                    the abs point in the size tag should reflect original size (namely x="38" y="38") multiplied by the 'texturescale' value in the CircleImage tag.
                                            -->
                <Window name = "$parentKillingSpree" layer="overlay">
                    <Size>
                        <AbsPoint x="270" y="111" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                    <Windows>
                        <CircleImage name="$parentArc" texture="EA_HUD_01" numsegments="32" layer="background">
                            <Size>
                                <AbsPoint x="81" y="80"/>
                            </Size>
                            <Anchors>
                                <Anchor point="center" relativePoint="center" relativeTo="$parent">
                                    <AbsPoint x="-81" y="-4" />
                                </Anchor>
                            </Anchors>
                            <TexCoords x="40" y="705" /> <!-- size is 77x77, upper left x=0, y=666-->
                        </CircleImage>
						<Window name="$parentBox" inherits="EA_Window_DefaultTooltipBackground">
							<Anchors>
                                <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                                    <AbsPoint x="20" y="68" />
                                </Anchor>
                                <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                                    <AbsPoint x="-183" y="-22" />
                                </Anchor>
                            </Anchors>
						</Window>
                        <Label name="$parentText" font="font_clear_tiny" maxchars="20" textalign="center">
                            <Size>
                                <AbsPoint x="80" y="30" />
                            </Size>
                            <Anchors>
                                <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                                    <AbsPoint x="14" y="62" />
                                </Anchor>
                            </Anchors>
                        </Label>
                    </Windows>
                </Window>
                
                

                <!-- Career rank badge: bottom-left portrait corner. -->
                <DynamicImage name="$parentLevelBackground" inherits="LevelBackgroundTemplate" handleinput="true" popable="false" layer="secondary">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="70" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverLevel" />
                    </EventHandlers>
                </DynamicImage>                
                

                <!-- RVR flag: portrait top center (same vertical axis as leader crowns). -->
                <DynamicImage name="$parentRvRFlagIndicator" inherits="RvRFlagIndicator" textureScale="0.55" popable="false" handleinput="true" layer="popup">
                    <Size>
                        <AbsPoint x="23" y="29" />
                    </Size>
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="11" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.OnMouseoverRvRIndicator" />
                    </EventHandlers>
                </DynamicImage>
                <Label name="$parentRvRFlagCountDown" font="font_heading_huge" maxchars="64" textalign="center" layer="popup" popable="false" handleinput="false">
                    <Size>
                        <AbsPoint x="800" y="72" />
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="Root">
                            <AbsPoint x="0" y="-230" />
                        </Anchor>
                    </Anchors>
                    <Color r="213" g="2" b="0" a="255" />
                </Label>      
                
                <!-- Relic Bonus Indicator -->
                <DynamicImage name="$parentRelicBonus" texture="EA_ScenarioSummary01_d5" slice="rank-highlighted" handleinput="true" popable="false" layer="secondary">
                    <Size>
                        <AbsPoint x="17" y="33" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="65"/>
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverRelicBonus" />
                    </EventHandlers>
                </DynamicImage>          
                
                
                <!-- Level Text -->
                <Label name="$parentLevelText" font="font_heading_rank" maxchars="10" textalign="center" autoresize="false" popable="false" layer="popup" handleinput="true">
                    <Size>
                        <AbsPoint x="31" y="32" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentLevelBackground">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
					<EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverLevel" />
					</EventHandlers>
                </Label>
                
                
                <!-- Yellow nag (left of badge): unspent career advancement points. -->
                <DynamicImage name="$parentAdvancementIndicator" inherits="AdvancementIndicator" handleinput="false" popable="false" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentLevelBackground">
                            <AbsPoint x="-6" y="1" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                
                
                <!-- Renown rank badge: bottom-right, mirrored from career rank at bottom-left. -->
                <DynamicImage name="$parentRenownRankBackground" inherits="LevelBackgroundTemplate" handleinput="true" popable="false" layer="secondary">
                    <Anchors>
                        <Anchor point="topright" relativePoint="topright" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="70" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverRenownRank" />
                    </EventHandlers>
                </DynamicImage>
                <Label name="$parentRenownRankText" font="font_heading_rank" maxchars="10" textalign="center" autoresize="false" warnOnTextCropped="false" popable="false" layer="popup">
                    <Size>
                        <AbsPoint x="31" y="32" />
                    </Size>
                    <Anchors>
                        <!-- Rank-Circle slice includes shadow; -1 X optically centers text in the visible ring. -->
                        <Anchor point="center" relativePoint="center" relativeTo="$parentRenownRankBackground">
                            <AbsPoint x="-1" y="0" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverRenownRank" />
                    </EventHandlers>
                </Label>

                <!-- Influence badge: bottom-center between career rank and renown (0–3 tiers).
                     Same Rank-Circle chrome as career/renown rank; unclaimed highlight TBD later. -->
                <DynamicImage name="$parentInfluenceBadgeBackground" inherits="LevelBackgroundTemplate" handleinput="true" popable="false" layer="secondary">
                    <Anchors>
                        <Anchor point="bottom" relativePoint="bottom" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverInfluenceBadge" />
                        <EventHandler event="OnLButtonUp" function="CustomUI.PlayerStatusWindow.OnLButtonUpInfluenceBadge" />
                        <EventHandler event="OnRButtonUp" function="CustomUI.PlayerStatusWindow.OnRButtonUpInfluenceBadge" />
                    </EventHandlers>
                </DynamicImage>
                <Label name="$parentInfluenceBadgeText" font="font_heading_rank" maxchars="2" textalign="center" autoresize="false" warnOnTextCropped="false" popable="false" layer="popup" handleinput="true">
                    <Size>
                        <AbsPoint x="31" y="32" />
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parentInfluenceBadgeBackground">
                            <AbsPoint x="-1" y="0" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnMouseOver" function="CustomUI.PlayerStatusWindow.MouseOverInfluenceBadge" />
                        <EventHandler event="OnLButtonUp" function="CustomUI.PlayerStatusWindow.OnLButtonUpInfluenceBadge" />
                        <EventHandler event="OnRButtonUp" function="CustomUI.PlayerStatusWindow.OnRButtonUpInfluenceBadge" />
                    </EventHandlers>
                </Label>

                <!-- Yellow nag (left of badge): unspent renown points. -->
                <DynamicImage name="$parentRenownIndicator" inherits="AdvancementIndicator" handleinput="false" popable="false" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentRenownRankBackground">
                            <AbsPoint x="-6" y="1" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>

                <!-- Yellow nag (left of badge): unclaimed influence rewards for tracked area/event. -->
                <DynamicImage name="$parentInfluenceIndicator" inherits="AdvancementIndicator" handleinput="false" popable="false" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentInfluenceBadgeBackground">
                            <AbsPoint x="-6" y="1" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>

                <!-- Leader crowns: portrait top center. -->
                <DynamicImage name="$parentGroupLeaderCrown" inherits="GroupLeaderCrown" handleinput="false" popable="false" layer="popup">
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                
                
                <!-- Warband Leader Crown -->
                <DynamicImage name="$parentWarbandLeaderCrown" inherits="WarbandLeaderCrown" handleinput="false" popable="false" layer="popup">
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parentPortraitFrame">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>

                <!-- Morale Mini -->
                <!-- Slice is dynamically changed depending on what abilities the player's morale percentage has unlocked -->
                <DynamicImage name="$parentMoraleMini" inherits="MoraleMiniTemplate" handleinput="false" layer="secondary" popable="false">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                            <AbsPoint x="86" y="39" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                
                
            </Windows>
        </Window>

    </Windows>
</Interface>

